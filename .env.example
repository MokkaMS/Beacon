# ============================================
# Discord Bot Configuration
# ============================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Comma-separated Discord User IDs who always have full Super-Admin access
BOT_OWNER_IDS=123456789012345678

# Optional: Restrict slash command registration to one guild for instant updates during dev
# Leave empty to deploy slash commands globally across all servers
DISCORD_DEV_GUILD_ID=

# ============================================
# Admin Web-Page & OAuth2 Configuration
# ============================================
# Public URL where the Admin Web-Page is reachable (e.g., https://bot.yourdomain.com)
PUBLIC_URL=http://localhost:3000
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Random secret string (min 32 chars) used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_secret_at_least_32_characters

# Web server port (inside container / host)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Optional: Set to "true" ONLY for local UI testing without Discord OAuth2
DEV_BYPASS_AUTH=false

# ============================================
# Storage & Monitoring
# ============================================
DATABASE_PATH=./data/bot.db
MC_DEFAULT_POLL_INTERVAL_SEC=60
MC_HISTORY_RETENTION_DAYS=30

# ============================================
# Cloudflare Tunnel (for Proxmox worldwide access)
# ============================================
# Create a tunnel in Cloudflare Zero Trust Dashboard and paste the token here
CLOUDFLARE_TUNNEL_TOKEN=
